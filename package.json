{
  "name": "agrocebada-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard del Reto AgroCebada FIRA 2026: predicción de rendimiento y simulador biofísico",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "datos": "python scripts/exportar_datos.py --modelo ../RendimientoCebada --simulador ../SimuladorBiofisico",
    "verificar:motor": "tsx scripts/verificar_motor.ts",
    "verificar:modelo": "tsx scripts/verificar_modelo.ts"
  },
  "dependencies": {
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
